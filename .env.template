# Copy this file to `.env` in the project root and fill in real values.
# On Railway, set these as service Variables instead of committing a file.

NODE_ENV="development"

# --- Discord (required) -----------------------------------------------------
# Create an application at https://discord.com/developers/applications
# OAuth2 tab -> Client ID + Client Secret. Bot tab -> Bot Token.
# Add an OAuth2 redirect of  <HOST>/api/auth/callback  (e.g.
# http://localhost:8080/api/auth/callback and the live Railway URL).
DISCORD_CLIENT_ID="some_id_from_discord"
DISCORD_CLIENT_SECRET="some_secret_from_discord"
DISCORD_BOT_TOKEN="some_bot_token"

# --- App (required) -------------------------------------------------------
# Any long random string. Used to sign login tokens.
JWT_SECRET="change_me_to_a_long_random_string"

# Port to listen on. Railway sets PORT automatically; 8080 for local dev.
PORT=8080

# Public origin of the app, used to build the Discord OAuth redirect.
# Local: http://localhost:8080 . On Railway you can leave HOST unset and it
# falls back to the injected RAILWAY_PUBLIC_DOMAIN.
HOST="http://localhost:8080"

# --- Database (required) ---------------------------------------------------
DATABASE_URL="postgres://<USERNAME>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>"
# Set to "true" for most public managed Postgres (SSL). Leave unset/false for
# a Railway/Render internal URL or local docker.
DATABASE_SSL="false"

# --- Challonge (optional; only used for the end-of-season bracket) --------
# Note: Challonge switched to a v2 "Connect" API. This is not wired up yet;
# leaving these blank is fine.
CHALLONGE_USERNAME=""
CHALLONGE_API_KEY=""

# --- Error logging (optional) -------------------------------------------
SENTRY_DSN=""
